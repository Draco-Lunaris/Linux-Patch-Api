#!/bin/sh
# Alpine Linux pre-deinstall script for linux-patch-api
# Runs before package files are removed (both upgrade and removal).
#
# On upgrade: do NOT stop or disable the service. The running process
# keeps serving on the old binary while apk replaces files on disk.
# The post-upgrade script restarts the service immediately.
#
# On removal: the post-deinstall script handles stopping and disabling.
# We cannot distinguish upgrade from removal here (apk passes no
# argument), so we do nothing in pre-deinstall.

echo "linux-patch-api pre-deinstall: service left running (immediate restart on upgrade, stop on removal)"
