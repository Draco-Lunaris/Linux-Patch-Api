[Unit]
Description=Linux Patch API self-update transaction
# No coupling to linux-patch-api.service — must survive its stop.
# After the agent's prerm stops it, this unit continues running
# in its own cgroup under system.slice.

[Service]
Type=oneshot
ExecStart=/usr/lib/linux-patch-api/self-update.sh
# Run in its own cgroup under system.slice (default for a separate unit).
# Allow up to 5 minutes for the upgrade to complete (package download + install).
TimeoutStartSec=300
# Ensure the unit is cleaned up after completion.
RemainAfterExit=no
