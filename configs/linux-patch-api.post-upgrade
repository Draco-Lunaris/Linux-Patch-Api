#!/bin/sh
# Alpine Linux post-upgrade script for linux-patch-api
# Runs after the new package version is installed during an upgrade.
#
# Restarts the service immediately to pick up the new binary.
#
# This is safe because the agent spawns package-manager processes (apk,
# and any subprocesses they create) in their own process group
# (process_group(0) in the Rust code). When OpenRC or systemd stops the
# agent process, the package-manager transaction continues in its own
# process group and completes the upgrade. The new agent binary starts
# fresh and detects the completed upgrade on startup.

if [ -d /run/systemd/system ]; then
    # systemd host — restart immediately (no-block to avoid deadlock
    # with the agent's SIGTERM handler).
    systemctl restart --no-block linux-patch-api.service
    echo "Upgrade complete — service restart triggered (systemd)"
else
    # OpenRC host (Alpine) — restart immediately. rc-service sends
    # SIGTERM to the agent process only; the apk transaction in its own
    # process group is unaffected.
    rc-service linux-patch-api restart >/dev/null 2>&1 &
    echo "Upgrade complete — service restart triggered (OpenRC)"
fi
