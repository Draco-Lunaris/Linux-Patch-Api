#!/bin/sh
# Alpine Linux post-upgrade script for linux-patch-api
# Runs after the new package version is installed during an upgrade.
# Schedules a 30s delayed restart so the running process (old binary)
# keeps serving while the new binary is already on disk.
# The bidirectional self-update guard ensures no concurrent package
# operations are running during this window.

nohup sh -c 'sleep 30 && rc-service linux-patch-api restart' >/dev/null 2>&1 &
echo "Upgrade complete — scheduled 30s delayed restart via OpenRC"
