#!/bin/sh
# Alpine Linux post-upgrade script for linux-patch-api
# Runs after the new package version is installed during an upgrade.
#
# Schedules a 300s delayed restart as a FALLBACK safety net.
#
# The agent itself performs state-based draining after the package
# install completes: it waits for all active operations to finish,
# then triggers the restart immediately. This timer is a fallback
# in case the agent crashes before completing the drain.

# Schedule a 300s fallback restart using systemd-run.
# Uses a named unit to ensure idempotency: if a previous restart is
# still waiting, it is replaced rather than duplicated.
mkdir -p /var/run
systemd-run --no-block --on-active=300 --unit=linux-patch-api-restart systemctl restart linux-patch-api.service
echo "Upgrade complete — scheduled 300s fallback restart via systemd-run"
