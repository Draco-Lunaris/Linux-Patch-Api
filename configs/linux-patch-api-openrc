#!/sbin/openrc-run
# OpenRC init script for linux-patch-api
# Used on Alpine Linux and other OpenRC-based systems
#
# Uses supervise-daemon for process management (OpenRC 0.42+).
# This replaces the previous command_background + pidfile approach
# which had a PID-file race on crash restart.

name="linux_patch_api"
description="Secure Remote Package Management API"
supervise_daemon_args="--stdout /var/log/linux_patch_api/linux-patch-api.log --stderr /var/log/linux_patch_api/linux-patch-api.err"
command="/usr/bin/linux-patch-api"
command_args="--config /etc/linux_patch_api/config.yaml"
command_background=true
pidfile="/run/linux-patch-api/linux-patch-api.pid"
output_log="/var/log/linux_patch_api/linux-patch-api.log"
error_log="/var/log/linux_patch_api/linux-patch-api.err"

# Required dependencies
depend() {
    use net logger
}

# Create required directories before starting
start_pre() {
    # Create directories with correct ownership
    checkpath --directory --owner root:root --mode 0755 \
        /run/linux-patch-api \
        /var/log/linux_patch_api \
        /var/lib/linux_patch_api \
        /etc/linux_patch_api/certs

    # Fix ownership of log files that may have been created by a non-root user
    for f in /var/log/linux_patch_api/linux-patch-api.log \
             /var/log/linux_patch_api/linux-patch-api.err; do
        if [ -f "$f" ]; then
            chown root:root "$f" 2>/dev/null
        fi
    done

    # Remove stale PID file from a previous crash (supervise-daemon handles
    # this, but we clean up just in case of a version downgrade)
    if [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile" 2>/dev/null)
        if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
            ewarn "Removing stale PID file (PID $pid no longer running)"
            rm -f "$pidfile"
        fi
    fi

    # Ensure config files exist
    if [ ! -f "/etc/linux_patch_api/config.yaml" ]; then
        eerror "Configuration file missing: /etc/linux_patch_api/config.yaml"
        eerror "Please create config.yaml before starting the service"
        return 1
    fi

    if [ ! -f "/etc/linux_patch_api/whitelist.yaml" ]; then
        eerror "Whitelist file missing: /etc/linux_patch_api/whitelist.yaml"
        eerror "Please create whitelist.yaml before starting the service"
        return 1
    fi
}

# Health check after start — verify the process is alive AND the API
# is listening on its port.
#
# IMPORTANT: We must NOT return 1 from start_post if the process is
# alive.  Returning 1 causes OpenRC to mark the service as "stopped"
# while supervise-daemon keeps the process running — orphaning it.
# OpenRC then can't stop the orphan on restart because it thinks the
# service is already stopped, leading to "Address already in use"
# errors on the next start.
#
# We use a TCP port check instead of curl because the agent enforces
# mTLS on all connections — curl without a client cert fails the TLS
# handshake (exit 55), making the HTTP health check unusable.
start_post() {
    CONFIG_FILE="/etc/linux_patch_api/config.yaml"
    PORT=$(grep -E '^\s*port:' "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*port:\s*//' | tr -d ' ')
    if [ -z "$PORT" ]; then
        PORT=12443
    fi

    # Retry loop: the agent takes ~10-15 seconds to initialize (CRL
    # load, repo provisioning, whitelist setup).  Try for up to 30
    # seconds before giving up.
    local retries=15
    local delay=2
    local ready=false

    for i in $(seq 1 $retries); do
        # Check if the process is still alive
        if [ -f "$pidfile" ]; then
            pid=$(cat "$pidfile" 2>/dev/null)
            if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
                eerror "linux-patch-api process (PID $pid) exited during startup"
                eerror "Check logs: cat /var/log/linux_patch_api/linux-patch-api.err"
                return 1
            fi
        fi

        # Check if the port is listening using /proc/net/tcp (no
        # external tools required).  The port in /proc/net/tcp is
        # in hexadecimal.  We also try netstat/ss as a fallback.
        local hex_port
        hex_port=$(printf '%04X' "$PORT" 2>/dev/null)

        if [ -n "$hex_port" ] && grep -q ":$hex_port " /proc/net/tcp 2>/dev/null; then
            ready=true
            break
        fi

        # Fallback: netstat or ss if available
        if command -v netstat >/dev/null 2>&1; then
            if netstat -tln 2>/dev/null | grep -q ":$PORT .*LISTEN"; then
                ready=true
                break
            fi
        elif command -v ss >/dev/null 2>&1; then
            if ss -tln 2>/dev/null | grep -q ":$PORT "; then
                ready=true
                break
            fi
        fi

        sleep $delay
    done

    if $ready; then
        einfo "linux-patch-api started successfully (listening on port $PORT)"
    else
        # Process is alive but port not yet listening after 30s.
        # Warn but do NOT return 1 — the process may still be
        # initializing (e.g. slow CRL fetch).  Returning 1 would
        # orphan the process and break future restarts.
        ewarn "linux-patch-api process is running but port $PORT not yet listening after 30s"
        ewarn "Check logs: cat /var/log/linux_patch_api/linux-patch-api.err"
        ewarn "Service will continue running — check status manually"
    fi
}

# Clean shutdown — send SIGTERM and let the process drain
stop_pre() {
    einfo "Stopping linux-patch-api service (SIGTERM — process will drain active operations)..."
}

# Verify service stopped
stop_post() {
    if [ -f "$pidfile" ]; then
        rm -f "$pidfile"
    fi
    einfo "linux-patch-api stopped"
}