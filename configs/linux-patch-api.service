[Unit]
Description=Linux Patch API - Secure Remote Package Management
Documentation=man:linux-patch-api(8)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/linux-patch-api --config /etc/linux_patch_api/config.yaml
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=120s

# Process management
RuntimeDirectory=linux-patch-api
RuntimeDirectoryMode=0755

# Fix ownership of log/state files that may have been created by a non-root user
# (e.g. during manual testing or enrollment). The service runs as root, so
# log files must be root-owned or tracing-appender will panic with
# "Permission denied" when trying to create/append the daily rolling log.
ExecStartPre=/bin/chown -R root:root /var/log/linux_patch_api /var/lib/linux_patch_api
ExecStartPre=/bin/mkdir -p /var/log/linux_patch_api /var/lib/linux_patch_api/state

# Security hardening
#
# Package-manager commands and package maintainer scripts must execute
# against the real host filesystem, mount namespace, hostname namespace,
# clock namespace, kernel-module tree, and syscall environment.  Any
# systemd sandboxing directive that creates a private namespace or
# restricts kernel/filesystem access will cause maintainer scripts to
# silently fail or produce corrupted host state (e.g. an initramfs
# generated without kernel modules, which makes the next boot fail).
#
# The following directives have been removed because they alter the
# environment required by package-manager commands and maintainer scripts:
#
#   - ProtectSystem=strict: Blocks writes to /usr, /etc, /lib where
#     packages install.
#   - NoNewPrivileges: Blocks sudo/setuid which apt needs for _apt sandbox.
#   - RestrictSUIDSGID: Blocks setuid/setgid which apt needs for _apt sandbox.
#   - CapabilityBoundingSet: Drops capabilities that apt needs (SETUID,
#     SETGID, CHOWN, etc.).
#   - AmbientCapabilities: Same issue as CapabilityBoundingSet.
#   - ProtectKernelModules=true: Makes /usr/lib/modules inaccessible, which
#     breaks update-initramfs (run as a dpkg trigger during patch-apply).
#     This caused boot failures on Ubuntu 24.04 and 26.04 — the initramfs
#     was generated without kernel modules, and the next boot failed.
#   - ProtectKernelTunables=true: Makes /proc/sys and /sys read-only, which
#     breaks postinst scripts that run sysctl (procps, systemd, shim-signed,
#     sysstat, systemd-coredump, keyboard-configuration, open-iscsi).
#   - ProtectKernelLogs=true: Makes /dev/kmsg and /proc/kmsg inaccessible,
#     which breaks postinst scripts that read the kernel log (rsyslog).
#   - RestrictNamespaces=true: Blocks namespace creation, which breaks
#     postinst scripts that use unshare/setns (apparmor).
#   - SystemCallFilter=@system-service: Blocks mount, umount, chroot,
#     pivot_root, init_module, finit_module, delete_module, sethostname,
#     setdomainname, clock_settime, adjtimex, settimeofday, swapon, swapoff,
#     and reboot syscalls. These are needed by package postinst/preinst
#     scripts (docker.io, fuse3, nfs-common, snapd, systemd, libc6,
#     nvidia-dkms, procps, dbus, coreutils-from-uutils, etc.).
#   - ProtectHome=true: Masks /home, /root, /run/user from the service
#     namespace. Package scripts that reference user home directories
#     (apparmor, kubuntu-settings-desktop) would fail.
#   - PrivateTmp=true: Creates a private /tmp and /var/tmp. Package scripts
#     that share temp files with other processes (hplip, openvpn, rsyslog,
#     screen) would fail.
#   - ProtectHostname=true: Creates a private UTS namespace. Package scripts
#     that call sethostname/setdomainname would fail.
#   - ProtectClock=true: Blocks clock_settime/adjtimex/settimeofday syscalls
#     and makes /dev/rtc* read-only. Package scripts that set the hardware
#     clock would fail.
#
# The API is privileged by design. It must rely on authentication (mTLS),
# authorization (IP whitelist), audit logging, and strict package-operation
# controls — not on OS-level sandboxing that is incompatible with the
# requirement to run arbitrary distribution maintainer scripts against the
# real host environment.
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true

# Environment
Environment="RUST_BACKTRACE=1"
Environment="DEBIAN_FRONTEND=noninteractive"
Environment="RUST_LOG=info"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linux-patch-api
SyslogFacility=daemon
SyslogLevel=info

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
