#!/bin/sh
# Alpine Linux post-deinstall script for linux-patch-api
# Runs after old package files are removed (both upgrade and removal).
#
# On upgrade: the new binary is already installed — do NOT stop.
# On removal: the binary is gone — stop and disable the service.
# We detect removal by checking if the binary still exists.

if [ ! -f /usr/bin/linux-patch-api ]; then
    # Actual removal (not upgrade) — binary is gone
    rc-service linux-patch-api stop 2>/dev/null || true
    rc-update del linux-patch-api default 2>/dev/null || true
    echo "Service stopped and disabled for removal"
else
    # Upgrade — new binary already installed, service still running old binary
    echo "Upgrade in progress — service left running (immediate restart triggered by post-upgrade)"
fi
