[Unit]
Description=Linux Patch API - Restart after package upgrade
ConditionPathExists=/var/lib/linux_patch_api/upgrade-pending

[Service]
Type=oneshot
# The fallback decision script is the SOLE authority for deciding
# whether a restart is allowed. The script reads the upgrade state
# file and the systemd ActiveState, then returns:
#
#   exit 0   restart is authorized — proceed to ExecStart
#   exit 55  safely skip this timer firing (replacement initializing,
#            grace period still active, or no-op)
#   any other nonzero  fail closed — do not restart
#
# The previous inline `systemctl is-active` / ActiveEnterTimestamp
# logic was removed because it duplicated the script's state machine
# and used `is-active` (which emits multi-line output for non-active
# states). The script uses `systemctl show --property=ActiveState
# --value` instead, which is deterministic.
#
# The `/bin/sh -c 'exec ...'` wrapper exists only so that
# `systemd-analyze verify` succeeds on development hosts where the
# script is not yet installed at its package path. The wrapper adds
# no decision logic — `exec` replaces sh with the script, so the
# script's exit code propagates directly to systemd.
ExecStartPre=/bin/sh -c 'exec /usr/lib/linux-patch-api/linux-patch-api-fallback-decision.sh'
ExecStart=systemctl restart linux-patch-api.service
# Do NOT use ExecStartPost to remove the marker.
# The new process removes the marker after successful readiness (READY=1).
RemainAfterExit=no

# Decoupled from main service — no Requires=, BindsTo=, PartOf=
# This unit must survive the agent being stopped/restarted.