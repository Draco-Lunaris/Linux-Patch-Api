#!/bin/bash
# postinst script for linux-patch-api
# Created by package build system
#
# Upgrade-aware: on upgrade ($2 is non-empty), we skip CRL/cert/config operations
# and restart the service immediately.

set -e

# Configure with debhelper
if [ "$1" = "configure" ]; then
    if [ -z "$2" ]; then
        # Fresh install: full setup
        echo "Configuring linux-patch-api..."
        
        # Create required directories with correct ownership
        mkdir -p /var/log/linux_patch_api /var/lib/linux_patch_api/state
        chown -R root:root /var/log/linux_patch_api /var/lib/linux_patch_api
        
        # Copy example configs if they don't exist
        if [ ! -f "/etc/linux_patch_api/config.yaml" ]; then
            echo "Creating default config.yaml..."
            cp /etc/linux_patch_api/config.yaml.example /etc/linux_patch_api/config.yaml
            chmod 640 /etc/linux_patch_api/config.yaml
            chown root:root /etc/linux_patch_api/config.yaml
        fi
        
        if [ ! -f "/etc/linux_patch_api/whitelist.yaml" ]; then
            echo "Creating default whitelist.yaml..."
            cp /etc/linux_patch_api/whitelist.yaml.example /etc/linux_patch_api/whitelist.yaml
            chmod 640 /etc/linux_patch_api/whitelist.yaml
            chown root:root /etc/linux_patch_api/whitelist.yaml
        fi
        
        # Reload systemd daemon to pick up new service file
        systemctl daemon-reload
        
        
        # Enable the service (but don't start automatically - admin should configure first)
        systemctl enable linux-patch-api.service
        
        # Check for TLS certificates and enrollment URL
        CERT_DIR="/etc/linux_patch_api/certs"
        CA_CERT="$CERT_DIR/ca.pem"
        SERVER_CERT="$CERT_DIR/server.pem"
        SERVER_KEY="$CERT_DIR/server.key.pem"
        CONFIG_FILE="/etc/linux_patch_api/config.yaml"
        
        CERTS_MISSING=false
        if [ ! -f "$CA_CERT" ] || [ ! -f "$SERVER_CERT" ] || [ ! -f "$SERVER_KEY" ]; then
            CERTS_MISSING=true
        fi
        
        if [ "$CERTS_MISSING" = true ]; then
            echo ""
            echo "⚠ TLS certificates are missing. The service will not start without them."
            echo ""
            
            # Check if enrollment.manager_url is configured
            if [ -f "$CONFIG_FILE" ]; then
                # Check for manager_url in config (handles both old String format and new Option format)
                MANAGER_URL=$(grep -E '^\s*manager_url:' "$CONFIG_FILE" 2>/dev/null | sed 's/^\s*manager_url:\s*//' | tr -d '"' | tr -d "'" | xargs)
                if [ -n "$MANAGER_URL" ] && [ "$MANAGER_URL" != "" ]; then
                    echo "✓ Auto-enrollment is configured (manager_url: $MANAGER_URL)"
                    echo "  Auto-enrollment will run on first service start."
                    echo "  The service will automatically request and provision certificates."
                else
                    echo "⚠ No enrollment.manager_url found in config.yaml."
                    echo ""
                    echo "To enable automatic certificate enrollment, add the manager URL:"
                    echo "  1. Edit /etc/linux_patch_api/config.yaml"
                    echo "  2. Add enrollment.manager_url: https://<your-manager-url>"
                    echo "  3. Start the service: systemctl start linux-patch-api"
                    echo ""
                    echo "Or enroll manually:"
                    echo "  linux-patch-api --enroll https://<your-manager-url>"
                    echo ""
                    echo "Or place certificates manually:"
                    echo "  - CA certificate: $CA_CERT"
                    echo "  - Server certificate: $SERVER_CERT"
                    echo "  - Server key: $SERVER_KEY"
                fi
            else
                echo "⚠ Config file not found at $CONFIG_FILE"
                echo "  Please configure the service before starting."
            fi
        else
            echo ""
            echo "✓ TLS certificates found. The service is ready to start."
            echo "  Start the service: systemctl start linux-patch-api"
        fi
        
        echo ""
        echo "linux-patch-api installed successfully!"
        echo ""
    else
        # Upgrade ($2 = previous version): preserve everything
        echo "Upgrading linux-patch-api from $2 ..."
        # DO NOT touch: config.yaml, whitelist.yaml, certs/, CRL
        systemctl daemon-reload

        # Schedule a DELAYED restart from a transient unit that runs in its
        # OWN cgroup, outside linux-patch-api.service. Do NOT restart the
        # agent immediately here.
        #
        # Why immediate restart is unsafe: this postinst runs INSIDE the
        # apt/dpkg transaction that the agent itself launched (the agent's
        # self-update runs apt-get/dpkg as a child process in the agent's
        # systemd cgroup). The unit has no explicit KillMode, so it defaults
        # to KillMode=control-group, which kills the ENTIRE agent cgroup —
        # including the apt/dpkg process that is still mid-configure when
        # this script returns. dpkg dies mid-configure ("dpkg failed
        # (signal)"), the package is left half-configured, and the agent's
        # own periodic `dpkg --configure -a` pre-flight re-runs this postinst
        # on the next health check, killing dpkg again — an infinite crash
        # loop that bricks the host on a half-configured package and blocks
        # all future upgrades. This exact bug left 6 hosts crash-looping on
        # a half-configured 2.6.14 during the 2.6.15 rollout.
        #
        # `process_group(0)`/setsid does NOT prevent this: setsid creates a
        # new session/process group but does NOT escape a systemd cgroup
        # (cgroup membership is inherited and unchanged by setsid), so
        # KillMode=control-group still reaches the apt/dpkg child.
        #
        # Fix: `systemd-run` launches the restart in a new transient unit
        # (lpa-postinst-restart) in its own cgroup, decoupled from the
        # agent's cgroup. The 30s --on-active delay lets dpkg/apt finish
        # configuring this package (and any pending triggers) BEFORE the
        # agent's cgroup is torn down and the new binary starts. --collect
        # garbage-collects the transient unit after it fires, so the unit
        # name is reusable on the next upgrade. If a previous scheduled
        # restart is still lingering (rapid re-upgrade), reset it first.
        systemctl reset-failed lpa-postinst-restart.service 2>/dev/null || true
        systemd-run --on-active=30s --unit=lpa-postinst-restart \
            --description="Linux Patch API post-upgrade restart" --collect \
            -- systemctl restart linux-patch-api.service
    fi
fi

# Handle upgrade
if [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-remove" ] || [ "$1" = "abort-deconfigure" ]; then
    echo "Installation aborted - service remains in previous state"
fi

exit 0
