#!/bin/bash
# prerm script for linux-patch-api
# Created by package build system

set -e

# Stop the service before removal only — NOT on upgrade.
# On upgrade, dpkg replaces files on disk while the old binary keeps
# running, then the postinst schedules a delayed restart (via
# systemd-run --on-active) that fires AFTER dpkg finishes, so the
# in-flight dpkg transaction is never killed by the restart.
if [ "$1" = "remove" ]; then
    echo "Stopping linux-patch-api service for removal..."
    
    if systemctl is-active --quiet linux-patch-api.service; then
        systemctl stop linux-patch-api.service
        echo "Service stopped successfully"
    else
        echo "Service was not running"
    fi
fi

# Only disable on removal, NOT on upgrade
# On upgrade, the postinst will re-enable and start the service.
if [ "$1" = "remove" ]; then
    if systemctl is-enabled --quiet linux-patch-api.service 2>/dev/null; then
        systemctl disable linux-patch-api.service
        echo "Service disabled"
    fi
fi

# Handle failed upgrade
if [ "$1" = "failed-upgrade" ]; then
    echo "Upgrade failed - attempting to restore previous state"
    # Previous version should handle restoration
fi

echo "Pre-removal script completed"

exit 0
